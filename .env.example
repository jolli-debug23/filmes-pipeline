# TMDB: crie uma conta em https://www.themoviedb.org/ e gere uma chave
# em Configurações, API (v3).
TMDB_API_KEY=

# OMDB: peça uma chave gratuita em https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# O universo de filmes (período, mínimo de votos, cota por mês) não fica aqui,
# fica em src/parametros.py, porque não é segredo e faz parte do método.

# Opcionais (valores padrão do src/ingest.py se não forem definidos)
# MAX_MOVIES_PER_RUN=100
# TMDB_REQUESTS_PER_SEC=4
# OMDB_MIN_INTERVAL_SEC=1.0
# OMDB_DAILY_LIMIT=900
